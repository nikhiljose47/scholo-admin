rules_version = '2';

// Shared Firebase project: this file replaces the project's Storage rules, which were
// previously just "deny everything". Keep the default deny at the bottom so no other
// path becomes accessible. Publish via the console or `firebase deploy --only storage`.
service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    // Temporary live-class thumbnails: live-class/{meetingId}/{1..4}.webp
    match /live-class/{meetingId}/{file} {
      allow read: if true;

      allow create, update: if isStaff()
                            && file.matches('[1-4]\.webp')
                            && request.resource.contentType.matches('image/.*')
                            && request.resource.size < 500 * 1024;

      allow delete: if isStaff();
    }

    // Everything else stays closed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
